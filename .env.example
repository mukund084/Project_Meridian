APP_ENV=development
ENABLE_API_DOCS=true

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
XAI_API_KEY=xai-your-key
PDF_DOWNLOAD_DIR=storage/pdfs
PDF_TEXT_CACHE_DIR=storage/text_cache
PDF_ALLOWED_HOSTS=escribemeetings.com
PDF_REDIRECT_LIMIT=5

# Comma-separated list of frontend origins allowed to call the API.
# Set this to your production frontend URL before publishing.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required in production. In development the API defaults to localhost-only hosts.
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Public API throttling.
RATE_LIMIT_REQUESTS=120
EXPENSIVE_RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
